{
  "manifest_version": 3,
  "name": "Brainbox Gig AI — Fiverr Autofill",
  "version": "3.1.2",
  "description": "Brainbox Ecom Lab's AI copilot for Fiverr: autofills gig pages and seller profile with Claude (or free Groq) using human-like typing, live market research, and click-optimized thumbnail prompts.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.fiverr.com/*",
    "https://api.anthropic.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.fiverr.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "brainbox-gig-ai@brainboxecomlab.com",
      "strict_min_version": "109.0"
    }
  }
}
